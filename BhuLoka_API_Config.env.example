# ==============================================================================
# BHU LOKA (भूलोक) — Optional External API Configuration
# Rename a copy to `.env` inside `Bhu Loka - भूलोक/` ONLY if you want cloud API
# upgrades. Everything core (Hybrid RAG, Copernicus DEM, Sentinel-1 SAR, MODIS LST,
# 36-State Sovereign India GeoJSON, Google Earth gl=IN tiles, Open-Meteo Weather,
# and GloFAS River Flood Discharge) already runs 100% FREE with ZERO keys!
# ==============================================================================

# 1. Optional Google Earth Engine Cloud Exports (`Repos/earthengine-api`)
#    Run once in terminal: `earthengine authenticate`
#    Then set your GCP Project ID below:
GOOGLE_CLOUD_PROJECT=

# 2. Optional Bharat Open Government Data (`https://data.gov.in`) Live Sync
DATA_GOV_IN_API_KEY=

# 3. Optional NASA Earthdata Bearer Token (Automated MODIS/VIIRS Swath Pulls)
NASA_EARTHDATA_TOKEN=

# 4. Optional Generative LLM Reasoning Layer (Only if you want cloud synthesis
#    on top of BHU LOKA's local BM25 + FAISS RRF retrieval evidence)
GEMINI_API_KEY=
